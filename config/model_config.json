{
  "version": "1.0.0",
  "models": {
    "v1": {
      "artifact": "src/models/v1.pkl",
      "weight": 90,
      "status": "production",
      "label": "Model v1.0 (Logistic Regression)"
    },
    "v2": {
      "artifact": "src/models/v2.pkl",
      "weight": 10,
      "status": "canary",
      "label": "Model v2.0 (Random Forest)"
    }
  },
  "routing": {
    "strategy": "canary",
    "shadow_mode": false,
    "shadow_percentage": 100
  },
  "rollback": {
    "enabled": true,
    "error_rate_threshold": 0.05,
    "latency_threshold_ms": 500,
    "min_requests": 20,
    "monitor_models": [
      "v2"
    ]
  },
  "security": {
    "jwt_secret_key": "CHANGE_ME_USE_A_LONG_RANDOM_SECRET_IN_PROD",
    "rate_limit_per_minute": 60,
    "api_key_env_var": "API_KEY",
    "allowed_feature_names": [
      "age",
      "workclass",
      "fnlwgt",
      "education",
      "education_num",
      "marital_status",
      "occupation",
      "relationship",
      "race",
      "sex",
      "capital_gain",
      "capital_loss",
      "hours_per_week",
      "native_country"
    ]
  },
  "audit": {
    "db_path": "adult_audit.db",
    "enabled": true,
    "drift_window_size": 100,
    "drift_min_samples": 30,
    "baseline_path": "src/models/adult_baseline.csv"
  },
  "mlops": {
    "feature_schema_version": "adult-income-v1",
    "model_metadata_path": "src/models/model_summary.json",
    "mlflow_experiment_name": "secure-ml-governance"
  }
}
